{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uplinq Studio",
  "version": "1.1.0",
  "identifier": "com.volti.ftp-client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Uplinq Studio",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0D0E11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Voltiq",
    "copyright": "© 2026 Voltiq",
    "category": "Utility",
    "shortDescription": "An SFTP, FTPS and FTP client",
    "longDescription": "Uplinq Studio moves files between your PC and your servers over SFTP, FTPS and FTP. Two panes side by side, drag and drop in both directions, a transfer queue that pauses and retries, saved sites with FileZilla import, and checks of the server's identity.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "German"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwNzEwNkFCMDdEMEYzQjQKUldTMDg5QUhxd1p4TUk1YnUybmdXeW1nMXFFYjRhVmxvYk44bDVBcWh0dnRrVDRLWXh1ZG9Pam8K",
      "endpoints": [
        "https://github.com/Voltiq/Uplinq-Studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
